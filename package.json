{
  "name": "wikimapia-mobile-preflight",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test:browser": "npm run build && playwright test",
    "test:probe": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "android:build": "npm run android:sync && cd android && ./gradlew clean assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "leaflet": "1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.56.1",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22"
  }
}
